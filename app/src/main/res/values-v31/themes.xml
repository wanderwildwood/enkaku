<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      No splash screen. Android 12 shows one whether or not an app asks, so it draws nothing:
      a transparent icon on white, indistinguishable from the app's own background. A logo
      that flashes up and vanishes costs a full-panel refresh before the app has done anything.
    -->
    <style name="Theme.BTRemote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_nothing</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
